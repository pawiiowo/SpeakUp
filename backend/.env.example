# Copia este archivo como .env y llena los valores. El .env real no se sube al repositorio.

# Conexión a PostgreSQL. En Supabase: Connect > Session pooler (el host directo solo tiene IPv6).
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres

# Clave para firmar los tokens JWT. Usa una cadena larga y aleatoria.
JWT_SECRET=cambia-esta-clave

# Puerto del servidor (opcional, por defecto 3000).
PORT=3000

# Orígenes web que pueden llamar a la API desde un navegador, separados por comas (opcional).
# Por defecto solo la versión web de Expo en la laptop.
CORS_ORIGINS=http://localhost:8081
